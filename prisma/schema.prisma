generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── ENUMS ───────────────────────────────────────────────────────

enum Role {
  ADMIN
  ORGANIZER
  PLAYER
}

enum TournamentStatus {
  UPCOMING
  PENDING
  OPEN
  ONGOING
  COMPLETED
}

// The underlying bracket engines — hardcoded, never user-defined
enum TournamentSystem {
  SINGLE_ELIMINATION
  DOUBLE_ELIMINATION
  SWISS
  ROUND_ROBIN
  HYBRID // multi-phase: e.g. Swiss → Top Cut Elimination
}

enum MatchStatus {
  PENDING
  ONGOING
  COMPLETED
}

enum GameTrackingMode {
  HP
  POINTS
}

// FORFEITED means the organizer removed the participant from a live
// tournament (see the participant-management spec).
enum ParticipantStatus {
  ACTIVE
  FORFEITED
}

enum OrganizerInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

// Lifecycle of an organizer's request for a game not yet in the catalog (todo.md §5).
enum GameRequestStatus {
  PENDING // awaiting an admin
  RESOLVED // an admin created/assigned the game
  DISMISSED // an admin declined it
}

// One entry per thing that happened to a specific user. The type drives the icon
// and styling on the frontend, so it is an enum rather than a free string.
enum NotificationType {
  MATCH_READY
  MATCH_RESULT
  TOURNAMENT_OPENED
  TOURNAMENT_STARTED
  TOURNAMENT_PLACEMENT
  PARTICIPANT_ADDED
  PARTICIPANT_REMOVED
  PARTICIPANT_FORFEITED
  ORGANIZER_INVITED
  GUEST_CLEANUP_SCHEDULED
  // An organizer asked for a game that is not yet in the catalog. Fanned out to
  // admins, who create the game and reassign the tournament (see todo.md §5).
  GAME_REQUESTED
  // A match's shared countdown timer reached zero. Sent to the tournament's
  // organizer(s) so they can act even if no browser was watching it.
  MATCH_TIMER_ENDED
  // An admin gave this user a medal or plaque (todo.md obj. 4.1).
  AWARD_RECEIVED
  // An organizer approved or rejected this player's tournament build (obj. 4.3).
  BUILD_REVIEWED
  // An admin removed this user's gallery image or build after a report.
  CONTENT_REMOVED
}

/// What kind of thing an audit entry records — the admin dashboard filters on it.
enum AuditCategory {
  TOURNAMENT
  PARTICIPANT
  MATCH
  STAFF
  USER
  AWARD
  CATALOG
  SYSTEM
  MODERATION
}

/// A tournament build (obj. 4.3): what a player brought, in a game-agnostic form.
enum BuildKind {
  IMAGE
  TEXT
  LINK
}

/// Only meaningful when the tournament requires builds — then organizers must
/// approve each one before it counts or is shown to other players.
enum BuildStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Who, besides the owner and staff, may see a tournament's builds.
enum BuildVisibility {
  PUBLIC
  AFTER_COMPLETION
  STAFF_ONLY
}

enum ReportReason {
  SPAM
  OFFENSIVE
  NOT_A_BUILD
  OTHER
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

/// A medal is a square a user may pin (up to three) to their profile; a plaque
/// is a 4:1 strip shown under their name (one, of their choosing). Called
/// "plaque" rather than "banner" on purpose: banner already means both the
/// tournament header image and the profile header image objective 4.2 wants.
enum AwardKind {
  MEDAL
  PLAQUE
}

// ─── MODELS ──────────────────────────────────────────────────────

model User {
  id String @id @default(uuid())

  /// Stored lowercased. Uniqueness is enforced case-insensitively by a
  /// functional index (see migration 20260911020000): `Alex@gmail.com` and
  /// `alex@gmail.com` are one inbox in practice, and with email as the second
  /// factor they must not be two accounts.
  email String? @unique

  /// The HANDLE — `@paul`. Unique case-insensitively, no spaces
  /// (USERNAME_PATTERN), and what you sign in and are @-mentioned with. The
  /// human-readable name lives in `displayName`.
  username String? @unique

  /// The human name — "Paul Scholes". Free-form, may contain spaces, NOT
  /// unique, and purely for display. Twitter/Steam/Discord all split identity
  /// this way: a stable handle for addressing, a changeable name for showing.
  /// Accounts that predate the split kept their old spaced username here.
  displayName String?
  /// A short public "about" line on the profile (todo.md obj. 4.2). Plain text,
  /// at most BIO_MAX_LENGTH characters — rendered as text, never as HTML.
  bio                    String?
  // URL-friendly public handle derived from username (e.g. "swift-falcon").
  // Unique like Tournament.slug; profile links resolve by slug OR legacy UUID so
  // old links never break. Generated on create and re-derived on username change.
  slug           String?   @unique
  hashedPassword String?
  isGuest        Boolean   @default(false)

  // Verification happens at registration, so every account created from here on
  // has a working address by construction — which is what makes emailed 2FA
  // codes viable as a mandatory second factor. Accounts that predate this were
  // marked verified in the migration rather than being forced through it.
  emailVerified   Boolean   @default(false)
  emailVerifiedAt DateTime?

  // One-time codes accepted in place of an emailed code. Bcrypt hashes, issued
  // once at registration. Email IS the second factor here, so a dead inbox would
  // otherwise be an unrecoverable lockout.
  twoFactorRecoveryCodes String[]

  // A password somebody ELSE chose — the seeded admin, or an account an admin
  // created or reset. The holder must replace it before they get a session: the
  // sign-in mints a `password_change` token instead, which every guard rejects.
  // Self-service password changes never set this; you do not need to be forced
  // to replace a password you picked.
  mustChangePassword Boolean @default(false)

  /// Sessions issued before this moment are void ("sign out everywhere", and
  /// every other browser when the password changes). Checked by JwtAuthGuard
  /// against the token's `iat`; null means nothing has been revoked.
  sessionsValidFrom DateTime?

  emailVerificationTokens EmailVerificationToken[]
  twoFactorCodes          TwoFactorCode[]
  trustedDevices          TrustedDevice[]
  roles          Role[]    @default([PLAYER])
  expiresAt      DateTime?
  isExpired      Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updateAt       DateTime  @updatedAt()

  tournamentsCreated      Tournament[]
  wonTournaments          Tournament[]            @relation("TournamentWinner")
  participatedTournaments TournamentParticipant[]
  matchesAsPlayer1        Match[]                 @relation("Player1")
  matchesAsPlayer2        Match[]                 @relation("Player2")
  wonMatches              Match[]                 @relation("Winner")
  createdFormats          TournamentFormat[]
  createdGames            Game[]
  gameRequests            GameRequest[]

  // NEW: global stats back-relation
  globalStats UserGlobalStats?
  gameStats   UserGameStats[]

  notifications Notification[]

  organizerRoles   TournamentOrganizer[] @relation("TournamentOrganizerUser")
  organizerInvites TournamentOrganizer[] @relation("TournamentOrganizerInviter")

  settingsChanged SystemSetting[]

  /// Google's stable account id (`sub` in its ID token) once this account is
  /// linked to Google sign-in. Matched before email, which can change.
  googleId String? @unique

  auditEntries   AuditLog[]  @relation("AuditActor")
  builds         TournamentBuild[] @relation("BuildOwner")
  buildsReviewed TournamentBuild[] @relation("BuildReviewer")
  galleryImages  GalleryImage[]
  reportsFiled   ContentReport[]   @relation("ReportFiler")

  awardsCreated  Award[]     @relation("AwardsCreated")
  awardsReceived UserAward[] @relation("AwardsReceived")
  awardsGiven    UserAward[] @relation("AwardsGiven")

  avatarUrl String? // path: /uploads/avatars/<uuid>.webp
}

/// The award catalog — what can be given. Admin-managed.
model Award {
  id          String    @id @default(uuid())
  name        String
  description String?
  kind        AwardKind
  /// /uploads/medals/<uuid>.webp (512x512, alpha) or /uploads/plaques/<uuid>.webp (1200x300).
  imageUrl    String
  createdAt   DateTime  @default(now())
  createdById String?
  createdBy   User?     @relation("AwardsCreated", fields: [createdById], references: [id], onDelete: SetNull)
  /// Archived awards can no longer be given, but stay on the profiles holding them.
  archivedAt  DateTime?

  grants UserAward[]

  @@index([kind])
}

/// One award given to one person. Repeats are separate rows, each with its own
/// date and note — "Champion" won three times is three grants, shown as x3.
///
/// Two invariants live in the migration as raw SQL, because Prisma cannot
/// express them: pinSlot is CHECKed to 1..3, and a partial unique index allows
/// at most one displayed plaque per user.
model UserAward {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation("AwardsReceived", fields: [userId], references: [id], onDelete: Cascade)
  awardId     String
  /// Restrict: an award that has been given cannot be deleted from under the
  /// people holding it. Archive it instead.
  award       Award    @relation(fields: [awardId], references: [id], onDelete: Restrict)
  awardedById String?
  awardedBy   User?    @relation("AwardsGiven", fields: [awardedById], references: [id], onDelete: SetNull)
  awardedAt   DateTime @default(now())
  note        String?
  /// 1-3 when this MEDAL is pinned to the profile; null otherwise.
  pinSlot     Int?
  /// True for the one PLAQUE shown under the user's name.
  displayed   Boolean  @default(false)

  @@unique([userId, pinSlot])
  @@index([userId])
  @@index([awardId])
}

// In-app inbox. Rows cascade with the user, so guest cleanup needs no special
// case. title/body are rendered text composed at write time: a notification is a
// historical record and must not change meaning when the tournament it refers to
// is later renamed or deleted.
model Notification {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type  NotificationType
  title String
  body  String?
  link  String? // in-app path, e.g. /tournaments/<id>/lobby

  tournamentId String? // for grouping only; deliberately no foreign key
  read         Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}

// ─── GAME (Admin-managed catalog — the thing being played) ────────
//
// A Game is first-class taxonomy, distinct from the tournament STRUCTURE
// (TournamentSystem) and from a FORMAT preset. Every Tournament names a real
// game — there is no fallback, so a tournament cannot be created until an admin
// has put something in the catalog (todo.md §5). Only admins create games —
// organizers request one, which fans out as a GAME_REQUESTED notification.
model Game {
  id          String  @id @default(uuid())
  name        String  @unique // "Chess", "Beyblade", "General"
  slug        String? @unique // optional URL-friendly key
  description String?
  iconUrl     String? // path: /uploads/assets/<uuid>.webp

  // Default tracking mode + rule defaults a format/tournament of this game can
  // inherit. Metadata for now (routing reads the resolved tournament config);
  // wired into config resolution in a later phase.
  trackingMode  GameTrackingMode @default(POINTS)
  defaultConfig Json?

  // A retired system row: the old built-in "General" floor. Not listed in the
  // catalog, not assignable to a tournament, and never deletable — historical
  // tournaments and UserGameStats still point at it. Nothing new is ever created
  // with this flag set.
  isBuiltin Boolean @default(false)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  tournaments Tournament[]
  formats     TournamentFormat[]
  userStats   UserGameStats[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  galleryImages GalleryImage[]
}

// An organizer's request for a game not yet in the catalog (todo.md §5). A durable
// queue so admins can work through requests, distinct from the fire-and-forget
// GAME_REQUESTED notification. Resolving one typically means creating the game and
// reassigning the originating tournament onto it.
/// Proves an address belongs to whoever is registering. The token is stored
/// HASHED: a leaked database must not hand over working verification links.
model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// A single emailed 2FA code. Hashed at rest for the same reason as above, and
/// `attempts` is what stops a 6-digit code being brute-forced — a million
/// guesses against an unlimited endpoint is minutes of work.
model TwoFactorCode {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  /// Set only when this code was entered CORRECTLY. `consumedAt` cannot tell
  /// the two apart: it is also stamped when a code is burned by five wrong
  /// guesses or superseded by a resend, and the resend throttle needs to
  /// punish those cases while letting a genuine re-login through.
  succeededAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// A browser that has already passed the second factor, so it is not challenged
/// again for 30 days. The cookie carries a random token; this row holds only its
/// hash, so a stolen database yields no usable device cookies.
model TrustedDevice {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  userAgent  String?
  lastUsedAt DateTime @default(now())
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Persisted runtime configuration, editable by an admin in the SETTINGS tab.
/// The first configuration this project stores anywhere: everything before it
/// was an env var, or (like DevService.setGuestExpiry) a static field that reset
/// on restart.
///
/// Resolution order is DB -> env -> default, so a container with env vars works
/// before anyone has logged in, and the admin UI overrides it afterwards.
///
/// `encrypted` marks values held as AES-256-GCM ciphertext (the SMTP key). Those
/// are never returned by the API — the UI shows a placeholder and can replace
/// them, but cannot read them back.
model SystemSetting {
  key       String  @id
  value     String
  encrypted Boolean @default(false)

  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
}

model GameRequest {
  id     String            @id @default(uuid())
  name   String // the requested game name
  note   String?
  status GameRequestStatus @default(PENDING)

  // The tournament that prompted the request, when there is one. A request can
  // also stand alone — with no fallback game, an organizer may have to wait for
  // the game to exist before the tournament can be created at all. Kept if the
  // tournament is later deleted (SetNull).
  tournamentId String?
  tournament   Tournament? @relation(fields: [tournamentId], references: [id], onDelete: SetNull)

  requestedById String?
  requestedBy   User?   @relation(fields: [requestedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// ─── TOURNAMENT FORMAT (Admin-managed named rulesets) ─────────────

model TournamentFormat {
  id          String           @id @default(uuid())
  name        String           @unique // "Beyblade Standard", "Pickleball Open"
  description String?
  gameName    String? // DEPRECATED — backfill source for gameId; drop after migration
  // Optional default game this preset pre-fills at tournament creation. NOT the
  // source of truth — the tournament's own game wins (todo.md §5).
  gameId      String?
  game        Game?            @relation(fields: [gameId], references: [id], onDelete: SetNull)
  system      TournamentSystem // the engine to run
  config      Json // all rules as JSON blob
  isBuiltin   Boolean          @default(false) // builtin formats cannot be deleted

  /// Nullable, SetNull: deleting the person who made a preset must not delete
  /// the preset — tournaments that have not started still read it, and the ones
  /// that have started keep their own copy either way (todo.md §4). Same rule
  /// as Tournament.createdById.
  createdById String?
  createdBy   User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  tournaments Tournament[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── TOURNAMENT ───────────────────────────────────────────────────

model Tournament {
  id          String           @id @default(uuid())
  name        String
  description String?
  maxPlayers  Int
  // Free text, not money (2026-09-15). Most prizes at this scale are physical —
  // "Trophy + medal", "Booster box", "Bragging rights" — and a Float could only
  // ever express the minority that are cash. Existing numbers were migrated to
  // "$<n>" text. `prizeImageUrl` optionally shows what the prize actually is;
  // the frontend turns the text into a link to it.
  prizePool      String?
  prizeImageUrl  String?
  entranceFee Float?
  venue       String?
  date        DateTime?
  inviteToken String           @unique @default(uuid())
  // Short human-readable invite name (e.g. "summer-cup"). The long
  // inviteToken UUID keeps working as a fallback, so old links never break.
  slug        String?          @unique
  isPrivate   Boolean          @default(false)
  /// Build submissions (obj. 4.3). Off: optional, shown without review. On:
  /// every active entrant must submit, and organizers approve each before start.
  buildsRequired    Boolean         @default(false)
  buildVisibility   BuildVisibility @default(AFTER_COMPLETION)
  buildsLockAtStart Boolean         @default(true)
  builds            TournamentBuild[]
  status      TournamentStatus @default(OPEN)

  // Format reference — points to admin-defined named ruleset
  formatId String?
  format   TournamentFormat? @relation(fields: [formatId], references: [id], onDelete: SetNull)

  // The game being played. Application-required: creation refuses without one
  // (todo.md §5, amended 2026-09-10 — no "General" fallback). Kept nullable at the
  // DB level for legacy rows still pointing at the retired placeholder and as the
  // SetNull backstop if a game is force-deleted. Tighten to NOT NULL once those
  // legacy rows are reassigned.
  gameId String?
  game   Game?   @relation(fields: [gameId], references: [id], onDelete: SetNull)

  // Per-tournament rules override; when set, fully replaces format.config
  config Json?

  /// Snapshotted at start, with `config` (todo.md §4). The bracket type and the
  /// preset's name are NOT part of the config, so without these a tournament
  /// still depended on its preset for its whole life — and deleting the preset,
  /// or the person who made it, left it with no system at all. Null until the
  /// tournament starts; read through `systemOf()`, which falls back to the live
  /// format.
  system     TournamentSystem?
  formatName String?

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  winnerId   String?
  winner     User?   @relation("TournamentWinner", fields: [winnerId], references: [id], onDelete: SetNull)
  winnerName String?

  guestCleanupAt DateTime?

  participants TournamentParticipant[]
  organizers   TournamentOrganizer[]
  rounds       Round[]
  gameRequests GameRequest[]

  bannerUrl String? // path: /uploads/banners/<uuid>.webp

  createdAt DateTime @default(now())
  // Set once, by completeTournament. The only record of WHEN an event finished:
  // status alone is a point-in-time flag, so without this no completion can be
  // placed on a timeline (admin analytics, 2026-09-10). Backfilled from the last
  // MatchGameLog for tournaments that finished before the column existed.
  completedAt DateTime?

  @@index([status])
  @@index([completedAt])
  @@index([createdById])
}

// ─── PARTICIPANTS ─────────────────────────────────────────────────

model TournamentParticipant {
  id           String @id @default(uuid())
  userId       String
  tournamentId String

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tournament Tournament @relation(fields: [tournamentId], references: [id])

  seed Int?

  // Final placing in this tournament (1 = champion), written at completion from
  // the resolved final placements. Null until the tournament completes. Powers
  // the profile "tournament history" / top-3 showcase.
  placement Int?

  // ACTIVE by default. FORFEITED means the organizer removed the player from a
  // live tournament: their pending matches are awarded to opponents and they are
  // skipped in future Swiss/hybrid pairings. See the participant-management spec.
  status ParticipantStatus @default(ACTIVE)

  // NEW: per-tournament stats back-relation
  stats TournamentParticipantStats?

  @@unique([userId, tournamentId])
  // The unique above leads with userId, so it cannot serve a tournamentId-only
  // filter - which is how nearly every read of this table is shaped.
  @@index([tournamentId])
}

// ─── PER-TOURNAMENT STATS (guests + registered users) ─────────────
//
// Tracks stats scoped to a single tournament.
// Guests are included because they have User rows (isGuest = true)
// and therefore have a TournamentParticipant row.
// Updated on every match completion within the tournament.
// OMW/OOMW are recomputed after each round resolves.

model TournamentParticipantStats {
  id String @id @default(uuid())

  participantId String                @unique
  participant   TournamentParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  gamesPlayed Int   @default(0)
  wins        Int   @default(0)
  losses      Int   @default(0)
  draws       Int   @default(0)
  points      Float @default(0)
  winRate     Float @default(0) // denormalized: wins / gamesPlayed, recomputed on update

  // Tiebreakers — recomputed after each round
  omw  Float @default(0) // Opponent Match Win rate
  oomw Float @default(0) // Opponent's Opponent Match Win rate

  updatedAt DateTime @updatedAt
}

// ─── GLOBAL STATS (registered users only, isGuest = false) ────────
//
// Aggregate across all tournaments the user has participated in.
// Never includes guests — filtered at write time (isGuest check).
// Maintained incrementally: updated after each match completes
// and after each tournament completes (for tournamentsPlayed/Won).

model UserGlobalStats {
  id String @id @default(uuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tournamentsPlayed Int   @default(0)
  tournamentsWon    Int   @default(0)
  gamesPlayed       Int   @default(0)
  wins              Int   @default(0)
  losses            Int   @default(0)
  draws             Int   @default(0)
  winRate           Float @default(0) // denormalized: wins / gamesPlayed, recomputed on update
  globalPoints      Int   @default(0) // cumulative placement points earned across all tournaments

  updatedAt DateTime @updatedAt
}

// ─── PER-GAME STATS (registered users only) ────────────────────────
//
// Same aggregation as UserGlobalStats, but bucketed by the game the
// tournament's game designates. Legacy rows (and the retired "General" bucket)
// are keyed by gameName; tournaments with no game only feed UserGlobalStats.
// Updated at the same write sites as UserGlobalStats.

model UserGameStats {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  gameName String // DEPRECATED — backfill source for gameId; keep until [userId, gameId] unique lands
  // Per-game FK. Nullable during the backfill transition; becomes the unique key
  // ([userId, gameId]) once every row is backfilled from gameName (todo.md §5).
  gameId   String?
  game     Game?   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  tournamentsPlayed Int   @default(0)
  tournamentsWon    Int   @default(0)
  gamesPlayed       Int   @default(0)
  wins              Int   @default(0)
  losses            Int   @default(0)
  draws             Int   @default(0)
  winRate           Float @default(0)
  globalPoints      Int   @default(0)

  updatedAt DateTime @updatedAt

  @@unique([userId, gameName])
  @@index([gameId])
}

// ─── ROUNDS & MATCHES ─────────────────────────────────────────────

model Round {
  id           String @id @default(uuid())
  tournamentId String
  roundNumber  Int

  matches Match[]

  tournament Tournament @relation(fields: [tournamentId], references: [id])

  @@unique([tournamentId, roundNumber])
}

model Match {
  id String @id @default(uuid())

  roundId String
  round   Round  @relation(fields: [roundId], references: [id])

  player1Id String?
  player2Id String?

  player1 User? @relation("Player1", fields: [player1Id], references: [id], onDelete: SetNull)
  player2 User? @relation("Player2", fields: [player2Id], references: [id], onDelete: SetNull)

  player1Score Int @default(0)
  player2Score Int @default(0)

  // Historical name snapshots — populated when a user is deleted
  p1Name     String?
  p2Name     String?
  winnerName String?

  winnerId String?
  winner   User?   @relation("Winner", fields: [winnerId], references: [id], onDelete: SetNull)

  nextMatchId     String?
  nextMatch       Match?  @relation("NextMatch", fields: [nextMatchId], references: [id])
  previousMatches Match[] @relation("NextMatch")

  loserNextMatchId     String?
  loserNextMatch       Match?  @relation("LoserNextMatch", fields: [loserNextMatchId], references: [id])
  previousLoserMatches Match[] @relation("LoserNextMatch")

  status MatchStatus @default(PENDING)
  isBye  Boolean     @default(false)

  matchIndex Int @default(0)

  // For HYBRID tournaments: which phase this match belongs to
  phase Int @default(1)

  createdAt DateTime       @default(now())

  // When play actually began and ended. createdAt is when the BRACKET was
  // generated, which is not the same thing and is why neither can be derived
  // from it. startedAt is stamped once, the first time the match goes ONGOING
  // (organizer start or advancement) and never re-stamped; completedAt is
  // stamped by completedMatchData() at every completion site.
  //
  // Byes, walkovers and dead matches complete the instant they are created, so
  // they carry a completedAt but no startedAt — operational metrics filter on
  // `isBye = false` AND both timestamps present, or their durations collapse
  // toward zero (2026-09-10).
  startedAt   DateTime?
  completedAt DateTime?

  gameLogs  MatchGameLog[]

  // Shared "match utilities" state (organizer timer + per-player coin/dice),
  // broadcast live to everyone viewing the match. Optional — a match only gets a
  // row once someone uses a utility.
  utilityState MatchUtilityState?

  // Postgres does not index foreign keys automatically. Every bracket read walks
  // matches by round, and forfeit/participant lookups filter on the two player
  // columns, so all three were sequential scans before these.
  @@index([roundId])
  @@index([player1Id])
  @@index([player2Id])
  @@index([winnerId])
  // Operational analytics scan completed matches by time, and hunt for matches
  // that have been ONGOING too long.
  @@index([completedAt])
  @@index([status, startedAt])
}

// ─── SHARED MATCH UTILITIES ────────────────────────────────────────
//
// Live, shared state for the "Match Utilities" panel (docs/shared-utilities-plan.md).
// One row per match. The timer is organizer-run and rendered from `timerEndsAt`
// so every viewer counts down in sync; coin/dice results are per-participant and
// stored in `flips` (a { userId: { kind, result, at } } map) so each person's
// latest is visible to all. Who may trigger each utility is resolved from the
// tournament config, not fixed here.
model MatchUtilityState {
  id      String @id @default(uuid())
  matchId String @unique
  match   Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)

  // Timer (staff-controlled). Remaining time is derived: while running,
  // timerEndsAt - now; while paused, timerPausedRemainingSec.
  timerDurationSec        Int?
  timerEndsAt             DateTime?
  timerRunning            Boolean   @default(false)
  timerPausedRemainingSec Int?
  // De-dupes the one finish notification the jobs sweep sends the organizer.
  timerNotified           Boolean   @default(false)

  // Latest coin/dice result per participant, as { [userId]: { kind, result, at } }.
  flips Json?

  updatedAt DateTime @updatedAt

  @@index([timerRunning])
}

model MatchGameLog {
  id      String @id @default(uuid())
  matchId String
  match   Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)

  gameNumber    Int // 1, 2, 3... (which game in the bestOf series)
  mode          GameTrackingMode // HP | POINTS
  startingValue Int // max HP or points threshold for this game

  player1Value Int @default(0) // HP remaining (HP mode) OR points scored (POINTS mode)
  player2Value Int @default(0)

  trackerActive Boolean   @default(true) // set to false once organizer submits game result
  winnerId      String? // null until game result is submitted
  completedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([matchId, trackerActive])
}

model SiteAsset {
  id        String   @id @default(uuid())
  key       String   @unique // e.g. "hero_slide_1", "home_banner"
  url       String // served path: /uploads/assets/<uuid>.webp
  label     String? // human-readable description for admin UI
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── STORE PRODUCTS (Landing Page Shop Carousel) ──────────────────

model StoreProduct {
  id          String   @id @default(uuid())
  name        String // display name e.g. "Hobby+ Hoodie"
  price       String // display price e.g. "₱1,299" (string for flexibility)
  imageUrl    String? // served path: /uploads/assets/<uuid>.webp
  category    String? // e.g. "APPAREL", "GEAR"
  description String?
  link        String? // external purchase link
  sortOrder   Int      @default(0) // controls carousel order
  isVisible   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── HOME PAGE BLOCKS (docs/home-blocks-plan.md) ──────────────────

/// One section of the public landing page: the hero, the store carousel, the
/// tournament preview. One table rather than a model per section — the page is
/// always fetched whole, every section's fields differ anyway, and adding a
/// section should be a row, not a migration.
///
/// `content` is the section's editable text and images, shaped per `key` and
/// whitelisted by `sanitizeContent` in HomeService before it is stored. A null
/// or absent row falls back to the built-in defaults, so the landing page still
/// renders on an empty database.
model HomeBlock {
  key       String   @id // "hero" | "shop" | "tournaments"
  order     Int // ascending render order on the landing page
  visible   Boolean  @default(true)
  content   Json?
  updatedAt DateTime @updatedAt
}

// Staff invited to co-manage one tournament. Only an ACCEPTED row grants access,
// which is checked in checkTournamentAccess and nowhere else.
model TournamentOrganizer {
  id           String     @id @default(uuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation("TournamentOrganizerUser", fields: [userId], references: [id], onDelete: Cascade)

  status      OrganizerInviteStatus @default(PENDING)
  // SetNull like Tournament.createdById: deleting the inviter must never destroy
  // the staff list.
  invitedById String?
  invitedBy   User?                 @relation("TournamentOrganizerInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  // Re-inviting an existing invitee is an update, not a duplicate row.
  @@unique([tournamentId, userId])
  // Serves "my pending invitations".
  @@index([userId, status])
}

/// One organizer or admin action, recorded after it succeeded (todo.md obj.
/// 3.1). Names are SNAPSHOTS taken before the action ran, and the tournament and
/// target have no foreign key, on purpose: the entry that says "deleted
/// tournament X" must outlive X. Only the actor is a real relation, and it is
/// SET NULL so deleting an admin's account does not erase what they did.
///
/// `metadata` holds only fields each route explicitly whitelists — never a
/// request body wholesale, which would put passwords and the SMTP key here.
model AuditLog {
  id             String        @id @default(uuid())
  createdAt      DateTime      @default(now())
  actorId        String?
  actor          User?         @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorName      String
  actorRoles     String[]
  category       AuditCategory
  action         String
  summary        String
  tournamentId   String?
  tournamentName String?
  targetUserId   String?
  targetName     String?
  metadata       Json?

  @@index([createdAt])
  @@index([actorId])
  @@index([tournamentId])
  @@index([category, createdAt])
}

/// What a player brought to one tournament (obj. 4.3) — an image, a plain-text
/// decklist, or a link. One live build per entrant: the uniqueness is a PARTIAL
/// index in the migration (only rows not removed), so a build an admin removed
/// does not block the player from submitting a new one.
model TournamentBuild {
  id           String      @id @default(uuid())
  tournamentId String
  tournament   Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  userId       String
  user         User        @relation("BuildOwner", fields: [userId], references: [id], onDelete: Cascade)
  kind         BuildKind
  imageUrl     String?
  text         String?
  url          String?
  status       BuildStatus @default(PENDING)
  reviewedById String?
  reviewedBy   User?       @relation("BuildReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  reviewNote   String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  /// Soft removal by an admin: hidden at once, purged after 30 days.
  removedAt     DateTime?
  removedById   String?
  removalReason String?

  reports ContentReport[]

  @@index([tournamentId])
  @@index([userId])
}

/// One image per game on a profile (obj. 4.3). Same partial-unique treatment as
/// builds: a removed image does not hold the slot.
model GalleryImage {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameId    String
  /// RESTRICT: GameService refuses to delete a game that has gallery images,
  /// with a message, rather than letting a delete wipe people's pictures.
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Restrict)
  imageUrl  String
  caption   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  removedAt     DateTime?
  removedById   String?
  removalReason String?

  reports ContentReport[]

  @@index([userId])
  @@index([gameId])
}

/// A report from a player, or a removal request from an organizer (fromStaff),
/// against one gallery image or one build. Only admins act on them.
model ContentReport {
  id                String         @id @default(uuid())
  galleryImageId    String?
  galleryImage      GalleryImage?  @relation(fields: [galleryImageId], references: [id], onDelete: Cascade)
  tournamentBuildId String?
  tournamentBuild   TournamentBuild? @relation(fields: [tournamentBuildId], references: [id], onDelete: Cascade)
  reporterId        String
  reporter          User           @relation("ReportFiler", fields: [reporterId], references: [id], onDelete: Cascade)
  reason            ReportReason
  note              String?
  /// Filed by an organizer or admin — sorts ahead of player reports.
  fromStaff         Boolean        @default(false)
  status            ReportStatus   @default(OPEN)
  resolvedById      String?
  resolvedAt        DateTime?
  createdAt         DateTime       @default(now())

  /// One report per person per item (Postgres treats NULLs as distinct, so the
  /// unused column never collides).
  @@unique([reporterId, galleryImageId])
  @@unique([reporterId, tournamentBuildId])
  @@index([status, createdAt])
}
