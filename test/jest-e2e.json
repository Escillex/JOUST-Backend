{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^prisma/(.*)$": "<rootDir>/../prisma/$1",
    "^uuid$": "<rootDir>/uuid-esm-stub.js"
  },
  "modulePaths": [
    "<rootDir>/../"
  ],
  "setupFiles": [
    "<rootDir>/jest-setup-env.js"
  ]
}