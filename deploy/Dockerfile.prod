# ── Backend production image (multi-stage) ───────────────────────────────────
# Build context is the backend repo root (compose sets `context: ${JOUST_SERVER_DIR}`).
# node:22 ships npm 10, which runs install scripts normally — so bcrypt/sharp
# native builds happen here (unlike the host's npm 12, which blocks them).
FROM node:22-alpine AS build
# node-gyp toolchain for bcrypt's native addon on musl (no prebuilt musl binary).
RUN apk add --no-cache python3 make g++
WORKDIR /app
COPY package*.json ./
RUN npm ci
# generate only reads the schema; no .env / DB needed at build time
COPY prisma ./prisma/
COPY prisma.config.ts ./
RUN npx prisma generate
COPY . .
RUN npm run build

# ── runtime ──────────────────────────────────────────────────────────────────
FROM node:22-alpine
LABEL org.opencontainers.image.source="https://github.com/Escillex/JOUST-Backend" \
      org.opencontainers.image.title="JOUST backend" \
      org.opencontainers.image.description="Tournament engine API (NestJS + Prisma)" \
      org.opencontainers.image.licenses="UNLICENSED"
# The backup service shells out to pg_dump/pg_restore/psql. Keep this runtime
# dependency in the canonical production image, just as it is in server/Dockerfile.
RUN apk add --no-cache postgresql17-client
WORKDIR /app
ENV NODE_ENV=production
# Copy the whole (already-compiled) node_modules from build — same base image, so
# the native addons match. We deliberately DO NOT prune: `prisma migrate deploy`
# runs at container start and needs the prisma CLI (a devDependency).
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY --from=build /app/prisma ./prisma
COPY --from=build /app/prisma.config.ts ./
COPY --from=build /app/package.json ./
# tsconfig(+build) let `prisma db seed` run its ts-node seed at container start
# (the seed is guarded, so it only actually writes on a fresh DB).
COPY --from=build /app/tsconfig.json ./
COPY --from=build /app/tsconfig.build.json ./
# ...and so does src/. The seed is TypeScript compiled on the fly by ts-node, and
# it imports from src (generateUniqueUserSlug, since 2026-09-04). Without these
# sources the seed dies with "Cannot find module '../src/user/user-slug.util'",
# which fails the whole start command — `migrate deploy && db seed && node` — and
# crash-loops the container. Shipping src costs nothing here: dist is the same
# code compiled, and node_modules is deliberately unpruned anyway.
COPY --from=build /app/src ./src
# Secret bootstrap + entrypoint for the published-image deploy. They are copied
# explicitly because the runtime stage cherry-picks from the build stage rather
# than taking the whole tree.
COPY --from=build /app/deploy/docker-entrypoint.sh /usr/local/bin/joust-entrypoint
COPY --from=build /app/deploy/init-secrets.sh /usr/local/bin/joust-init-secrets
RUN chmod +x /usr/local/bin/joust-entrypoint /usr/local/bin/joust-init-secrets
EXPOSE 4000
# The entrypoint resolves secrets, builds DATABASE_URL, migrates and seeds, then
# execs CMD. It is a no-op passthrough when every value is already in the
# environment, which is what the pm2 and build-from-source paths do.
ENTRYPOINT ["/usr/local/bin/joust-entrypoint"]
CMD ["node", "dist/src/main.js"]
