# ─────────────────────────────────────────────────────────────────────────────
# Optional overrides for the published-image deployment. Copy to `.env` beside
# compose.yml and edit — or delete it entirely: every value below has a working
# default, and `docker compose up -d` needs none of them.
# ─────────────────────────────────────────────────────────────────────────────

# ── Where the site is reached ────────────────────────────────────────────────
# JOUST_PUBLIC_URL is the address a browser types. The backend requires it in
# production (it refuses to reflect arbitrary origins while sessions are
# credentialed), so if you change the port or add a domain, change this too.
#JOUST_PUBLIC_URL=http://localhost:8080

# Published host ports. Defaults avoid the privileged ports so a first run never
# collides with an existing web server.
#JOUST_HTTP_PORT=8080
#JOUST_HTTPS_PORT=8443

# ── HTTPS on a real domain ───────────────────────────────────────────────────
# Set all four together. Caddy then obtains and renews a Let's Encrypt
# certificate on its own; the DNS record must already point at this host, and
# ports 80 and 443 must be the published ones (ACME uses them).
#JOUST_SITE_ADDRESS=joust.example.com
#JOUST_PUBLIC_URL=https://joust.example.com
#JOUST_HTTP_PORT=80
#JOUST_HTTPS_PORT=443

# ── Version ──────────────────────────────────────────────────────────────────
# Defaults to `latest`. Pin a release tag for a deployment you do not want
# moving under you: JOUST_VERSION=v1.0.0
#JOUST_VERSION=latest

# ── Secrets ──────────────────────────────────────────────────────────────────
# Leave these unset and they are generated on first boot into the `secrets`
# volume. Set one and it is adopted into that volume instead — which is how you
# restore a stack whose secrets you still hold, or move one to a new host.
#
# ⚠ SETTINGS_ENCRYPTION_KEY encrypts every full database backup. Supplying the
#   WRONG one makes existing backups undecryptable. 64 hex characters.
#JWT_SECRET=
#SETTINGS_ENCRYPTION_KEY=
#POSTGRES_PASSWORD=
#ADMIN_PASSWORD=

# The first administrator's sign-in address (used only when the database is
# empty; the seed never touches an existing admin).
#ADMIN_EMAIL=admin@joust.local

# ── Database ─────────────────────────────────────────────────────────────────
# Changing these after the first boot does NOT rename an existing database.
#POSTGRES_USER=joust
#POSTGRES_DB=joust

# ── Mail ─────────────────────────────────────────────────────────────────────
# `console` prints verification codes to `docker compose logs server`. Configure
# real SMTP in the admin settings UI rather than here.
#MAIL_TRANSPORT=console
